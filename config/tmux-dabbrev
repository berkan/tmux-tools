#!/usr/bin/env python3
# tmux-dabbrev expand|tab|undo PANE — complete the word before the cursor in
# PANE, as Emacs' dabbrev does from the buffer. What was typed is read off the
# screen left of the cursor, and the completion is typed into the program
# (Backspaces, then the text), so it works in any program that takes typed
# keys: Claude Code, pi, a shell. Completions come from a backend, the first
# in BACKENDS whose trigger matches the text before the cursor:
#
#   snippets      a word starting , (,rr): the snippets in the file named by
#                 @dabbrev-snippets (default ~/.pi/agent/tmux-dabbrev.snippets)
#                 whose names start with the rest, by name; Tab needs a
#                 letter of it, M-/ takes , alone (all of them). One a line:
#                 NAME TEXT, # for a comment; in TEXT | is where the cursor
#                 goes, \n a line break (pasted, so not Enter), \s a space
#                 (at the end), \| and \\ a bar and a backslash. Read each
#                 time a ,NAME completion starts (not cached: edits apply at
#                 once).
#   paths         a word starting ~/, ./, ../, // (for /: alone, / is the
#                 program's commands) or /folder/: first the paths on screen
#                 that start with it (ranked as words are; ~/ and /Users/me/
#                 are one), then the files in its folder, relative to the
#                 pane's directory. A file ends in a space, a folder in /.
#                 Dotfiles only when what was typed starts with a dot. Tab
#                 after a folder: what is in it, the same way.
#   program       Tab on a word starting @ or /: sent on to the program (its
#                 own file and command completion).
#   screen        the words on the pane's screen (not the scrollback), and
#                 its entities: coloured spans (runs of text in a style of
#                 their own, such as an id or a path, not a whole line),
#                 CamelCase words and runs of Capitalised Words, those of
#                 the kinds in @dabbrev-entities (default: coloured
#                 camelcase capitalised; '' none); below.
#
# A completion from the screen ends in a space, so the next press can follow
# at once.
#
#   ^WORD, ^ WORD (on the screen's words) only words that begin a line; the
#                 ^ goes. -WORD the list items that start so, each whole
#                 (the rows it wraps onto too); .WORD the sentences that
#                 start so, each whole (to . ! ? or :, or a blank row or a
#                 list item); the mark goes, and with no such match, as
#                 before, the mark kept. 2. (or 2)) the items numbered so,
#                 whole. A mark is an anchor only when it touches the word:
#                 in "- W" and ". W" (! ? :) it is text, and W completes as
#                 any word.
#                 _WORD the rows that start so, whole (^WORD..$), else as
#                 before (_private).
#                 =WORD only entities, those of more words first; the =
#                 goes, and with none such, nothing. After an anchor one
#                 letter is enough for Tab (-W, ^H).
#   ...WORD       (on the screen's words) everything from where the text
#                 before ... leaves off on screen up to a word starting with
#                 WORD, with what is on it (consumes.), line breaks as
#                 spaces; ...$ to the end of the line, ...$$ to the end of
#                 the block (up to a blank row, lists too), .... (or
#                 ...) to the end of the sentence, ...? ...! to the next
#                 such mark. As Ruby's ranges (@dabbrev-ruby-ranges, on unless
#                 off) .. takes the end and ... stops before it: ...Then up
#                 to Then, .... a sentence without its full stop (... alone
#                 is .. and .: with it); off, ... is ... A space may follow.
#                 After an anchored query (^T..$$, -W ..cl): each match of
#                 the query, taken on to its first such end; M-/ the next
#                 match. Otherwise: from where the last Tab took its words, else from
#                 where the words before ... are. M-/ goes on to the next
#                 such word; Tab after it, word by word.
#
# After an opening quote or bracket that begins a word ("hel, (hel), the
# completion is closed with its pair ("hello" ), the closer moving on as Tab
# adds words; not once the text holds the closer, nor for a snippet. With the
# closer right after the cursor already (,rr's re: "|" -- ), the completion
# ends against it, without its space.
#
#   expand (M-/)  the best word on screen that starts with what was typed:
#                 the entities before any word (and only they for
#                 punctuation alone, such as ["); within each, one after the
#                 words typed before it, as many as possible, then in the
#                 order in @dabbrev-span-order for the spans, @dabbrev-order
#                 for the rest (ORDERS; default for both: nearest the middle
#                 of the screen). Again, the next best replaces it, and past
#                 the last, what was typed comes back. After a Tab, the same
#                 for the words that Tab added: the other words that follow
#                 the word before them elsewhere on screen; past the last,
#                 none. Smart case: case matters only when what was typed has
#                 a capital; the word goes in as it is on screen.
#   tab (Tab)     the same first completion; again, the word that follows it
#                 on screen, with what is between them (a line break as a
#                 space), and so on, from where the last M-/ chose. On a
#                 word that has no longer match on screen, Tab goes on at
#                 once with the words after it elsewhere on screen. Tab is
#                 sent on to the program instead when there is nothing to
#                 complete: no backend takes the word (for the screen, under
#                 two letters before the cursor) or it has no match.
#   undo (M-?)    take back the last press; again, the one before, back to
#                 what was typed.
#
# A press goes on from the last one while the program, the cursor's row and
# the text left of the cursor are as the last one left them; else it starts
# afresh. The state is kept in a file per pane under $TMPDIR (a tmux option
# cannot hold it: one command carries at most about 16 KB).
#
#   tmux-dabbrev bind   bind the keys in @dabbrev-key (default M-/) and
#       @dabbrev-undo-key (default M-?) without the prefix, and Tab in the
#       programs named in @dabbrev-tab-commands (by #{pane_current_command};
#       empty: Tab is left alone); run it from tmux.conf after setting them.
#       All run in the foreground, so keys typed meanwhile wait and stay in
#       order.
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import unicodedata

WORD = re.compile(r"\w(?:[\w'./-]*\w)?")       # inside: ' . / - (paths, don't)
TYPED = re.compile(r"\w[\w'./-]*$")
OPEN = r"""(?:^|(?<=[\s"'`(\[{<]))"""         # an anchor starts a word, or follows a quote or bracket
LINE_TYPED = re.compile(OPEN + r"\^ ?\w[\w'./-]*$")               # ^word, ^ word
NUMBER_TYPED = re.compile(OPEN + r'\d+[.)]$')                       # 2. 2)
LIST_MARK = re.compile(r'\W*?(?:[-*•+]|\d+[.)])\s+')             # what begins a list item
# ..word or ...word (a space between or none): up to the word; $ the line's
# end, $$ the block's; . the sentence's (so "..." and "...." too), ? or ! the
# next such mark.
UPTO = r"(\.\.\.?) ?(\w[\w'./-]*|\$\$?|[.!?])"
# As Ruby's ranges (@dabbrev-ruby-ranges, on unless off): .. takes the end,
# ... stops before it (...Then, .... a sentence without its full stop).
RUBY_OPTION = '@dabbrev-ruby-ranges'
UPTO_TYPED = re.compile(r"""(?:^|(?<=[\s\w"'`(\[{<]))""" + UPTO + "$")   # also right after a word
# An anchored query before it (^T..$$, ^The other..$$, -W ..cl): each match of
# the query on screen (its first word anchored, the rest following it, each a
# prefix), taken on to its first such end.
QUERY = r"(?:\^ ?|[-.=])\w[\w'/-]*"
QUERY_UPTO = re.compile(OPEN + r"(?P<query>" + QUERY + r"(?: [\w'/-]+)*) ?(?P<op>" + UPTO + ")$")
BLOCK_END = re.compile(r'\n[ \t]*\n')                                    # a blank row
PART_END = re.compile(r'\n[ \t]*(?:\n|\W*?(?:[-*•+]|\d+[.)])\s)')        # or a list item
SNIPPET_TYPED = re.compile(r'(?:^|(?<=\s)),([\w.-]*)$')
SNIPPETS_OPTION, SNIPPETS_DEFAULT = '@dabbrev-snippets', '~/.pi/agent/tmux-dabbrev.snippets'
PATH_TYPED = re.compile(r"""(?:^|(?<=[\s'"`(\[{<=]))(?:~/|\.\.?/|//|/[^/\s]+/)[^\s'"`]*$""")
SCREEN_PATH = re.compile(r"""(?:^|(?<=[\s'"`(\[{<=]))(?:~|\.\.?)?/[^\s'"`()\[\]{}<>|;:,]*""")
ESCAPE = re.compile(r'\x1b\[([0-9;:]*)m|\x1b\[[0-9;:?]*[A-Za-z]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b.')
DEFAULT = (None, None, frozenset())             # (foreground, background, attributes)
# Entities beside the coloured spans: a CamelCase word (camelCase, iPhone: a
# capital after a small letter or digit), and two or more Capitalised Words
# of two letters or more each (not "When I").
CAMEL = re.compile(r'(?<![\w])[A-Za-z0-9]*[a-z0-9][A-Z][A-Za-z0-9]*(?![\w])')
ENTITIES_OPTION, ENTITIES_DEFAULT = '@dabbrev-entities', 'coloured camelcase capitalised'
CAPITALISED = re.compile(r"(?<![\w'’-])[A-Z][\w'’-]+(?: [A-Z][\w'’-]+)+(?![\w'’-])")
KEYS = {'expand': ('@dabbrev-key', 'M-/'), 'undo': ('@dabbrev-undo-key', 'M-?')}
TAB_OPTION, TAB_DEFAULT = '@dabbrev-tab-commands', 'claude codex pi node agy gemini'
CONTEXT = 3                     # words before what was typed that rank a match
# The order of matches that rank alike otherwise, named in @dabbrev-order for
# words and paths and @dabbrev-span-order for coloured spans:
# the sort key of the match at character A of ROW, START being where what was
# typed starts on the cursor's row and COUNT how often the match is on screen.
ORDERS = {
    # nearest the middle row of the screen; of two as far, the lower
    'middle': lambda pane, row, a, start, count: (abs(row - pane.middle), row < pane.middle, a),
    # the most often on screen, then as middle
    'frequent': lambda pane, row, a, start, count: (-count, abs(row - pane.middle), row < pane.middle, a),
    # nearest the cursor; of two rows as far, the upper
    'cursor': lambda pane, row, a, start, count: (abs(row - pane.cy), row > pane.cy, abs(a - start)),
    # reading order
    'top': lambda pane, row, a, start, count: (row, a),
}
ORDER_OPTIONS = {False: '@dabbrev-order', True: '@dabbrev-span-order'}     # by: is a span
ORDER_DEFAULT = 'middle'


def tmux(*args, check=True):
    return subprocess.run(['tmux', *args], check=check, text=True,
                          stdout=subprocess.PIPE).stdout


def cell_width(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in 'WF' else 1


def left_of(line, cx):
    """The characters of LINE in the cells left of column CX."""
    col = 0
    for i, ch in enumerate(line):
        if col >= cx:
            return line[:i]
        col += cell_width(ch)
    return line


def smartcase(typed, word):
    if typed != typed.lower():
        return word.startswith(typed)
    return word.lower().startswith(typed.lower())


def context(words, before):
    """How many of the words BEFORE (nearest last) end the list WORDS, case
    aside: the words on screen before a match against those typed before it."""
    n = 0
    while n < min(len(words), len(before)) and words[-1 - n].lower() == before[-1 - n].lower():
        n += 1
    return n


def after(screen, cy, row, end, start):
    """The text after a word ending at END of ROW to the end of SCREEN, rows
    joined by newlines, without the cursor's row (CY) past START."""
    rest = screen[row][end:start] if row == cy and end <= start else screen[row][end:]
    return '\n'.join([rest] + [line for r, line in enumerate(screen) if r > row and r != cy])


def sgr(style, params):
    """STYLE (foreground, background, attributes) after an SGR sequence with
    PARAMS."""
    fg, bg, attrs = style
    ps = re.split('[;:]', params)
    i = 0
    while i < len(ps):
        p = int(ps[i]) if ps[i].isdigit() else 0
        if p == 0:
            fg, bg, attrs = DEFAULT
        elif p in (38, 48):                     # 38;5;N or 38;2;R;G;B
            n = 2 if ps[i + 1:i + 2] == ['5'] else 4
            colour = ';'.join(ps[i + 1:i + 1 + n])
            fg, bg = (colour, bg) if p == 38 else (fg, colour)
            i += n
        elif 30 <= p <= 37 or 90 <= p <= 97:
            fg = str(p)
        elif 40 <= p <= 47 or 100 <= p <= 107:
            bg = str(p)
        elif p == 39:
            fg = None
        elif p == 49:
            bg = None
        elif 1 <= p <= 9:
            attrs = attrs | {p}
        elif 21 <= p <= 29:
            attrs = attrs - ({1, 2} if p == 22 else {p - 20})
        i += 1
    return fg, bg, attrs


def styled(line):
    """[(character, style)] of LINE as capture-pane -e gives it."""
    out, style, pos = [], DEFAULT, 0
    for m in ESCAPE.finditer(line):
        out += [(ch, style) for ch in line[pos:m.start()]]
        pos = m.end()
        if m.group(1) is not None:
            style = sgr(style, m.group(1))
    return out + [(ch, style) for ch in line[pos:]]


def spans(plain, escaped):
    """[(start, end)] in PLAIN of the runs of text in a style of their own (not
    the default), and of each stretch in styles not the default that holds
    more than one of them (**Does `When` set up?**: the bold sentence and its
    coloured word); trimmed of spaces and of , : ; at the end (**swiz:**).
    ESCAPED is the line with its escapes. Not a run that is all the line's
    text and faint, or on a background but not bold, as a grey line or a
    diff's is (a bold heading is a span, on a background or not)."""
    cells = styled(escaped)
    if ''.join(ch for ch, _ in cells).rstrip() != plain.rstrip():
        return []                               # the screen changed between the captures

    def runs(same):
        out, i = [], 0
        while i < len(cells):
            j = i
            while j < len(cells) and same(cells[j][1], cells[i][1]):
                j += 1
            if cells[i][1] != DEFAULT:
                out.append((i, j))
            i = j
        return out
    out = []
    for i, j in runs(lambda x, y: x == y) + runs(lambda x, y: (x == DEFAULT) == (y == DEFAULT)):
        text = plain[i:j]
        a, b = i + len(text) - len(text.lstrip()), i + len(text.rstrip().rstrip(',:;'))
        whole = plain[a:b] == plain.strip()
        if whole and any(2 in style[2] or (style[1] is not None and 1 not in style[2])
                         for _, style in cells[i:j]):
            continue
        if b - a >= 2 and (a, b) not in out:
            out.append((a, b))
    return out


def entity_kinds():
    """The kinds of entity named in @dabbrev-entities: coloured, camelcase,
    capitalised (unset: all; empty: none)."""
    value = tmux('show-options', '-gqv', ENTITIES_OPTION)
    if value == '' and not tmux('show-options', '-gq', ENTITIES_OPTION):
        value = ENTITIES_DEFAULT
    return set(value.split())


def entities(plain, escaped, kinds):
    """[(start, end)] in PLAIN of its entities of the KINDS (entity_kinds):
    coloured spans (spans; ESCAPED is the line with its escapes), CamelCase
    words, runs of Capitalised Words. In dabbrev they rank as one, before the
    words; in copy mode y, p and r take the one under the cursor
    (tmux-link)."""
    found = spans(plain, escaped) if 'coloured' in kinds and escaped is not None else []
    for kind, pattern in (('camelcase', CAMEL), ('capitalised', CAPITALISED)):
        if kind in kinds:
            found += [m.span() for m in pattern.finditer(plain)]
    return found


def paths(line):
    """[(start, end)] of what looks like a path in LINE: ~/, ./, ../ or /
    and what follows up to a space, quote or bracket, without punctuation
    after it."""
    out = []
    for m in SCREEN_PATH.finditer(line):
        b = m.start() + len(m.group().rstrip('.!?'))
        if b - m.start() >= 2:
            out.append((m.start(), b))
    return out


def line_start(pane, row, a):
    """Whether character A of ROW begins its line: nothing but spaces and
    marks (⏺, │) before it."""
    return not re.search(r'\w', pane.screen[row][:a])


def list_item(pane, row, a):
    """Whether character A of ROW is the first of a list item: after a
    marker (- * • + 1. 1)) that begins the line."""
    return bool(re.fullmatch(r'\W*?(?:[-*•+]|\d+[.)])\s+', pane.screen[row][:a]))


def sentence_start(pane, row, a):
    """Whether character A of ROW begins a sentence: after . ! ? or :, or
    beginning a line after one that ends a sentence or is blank."""
    head = pane.screen[row][:a]
    if re.search(r'[.!?:]["\'’”)\]]*\s+$', head):
        return True
    if re.search(r'\w', head):
        return False
    above = pane.screen[row - 1].strip() if row else ''
    return not above or bool(re.search(r'[.!?:]["\'’”)\]]*$', above))


def item_at(pane, row, a):
    """(text, following): the list item whose text starts at character A of
    ROW, with the rows it wraps onto (indented as far; up to a blank row or
    another item), joined by spaces, and the text after it (after)."""
    parts, last = [pane.screen[row][a:].strip()], row
    for r in range(row + 1, len(pane.screen)):
        line = pane.screen[r]
        if r == pane.cy or not line.strip() or len(line) - len(line.lstrip()) < a or LIST_MARK.match(line):
            break
        parts.append(line.strip())
        last = r
    return ' '.join(parts), after(pane.screen, pane.cy, last, len(pane.screen[last]), 0)


def list_items(pane, start, typed, number=None):
    """Alternatives for the list items on screen whose first word starts with
    TYPED (smart case), or with NUMBER (digits) those numbered so: each whole
    (item_at), best first (ranked)."""
    if number is None:
        where = list_item
        accept = lambda text, kind: kind == 'word' and smartcase(typed, text) and text
    else:
        numbered = re.compile(r'\W*?' + re.escape(number) + r'[.)]\s+')
        where = lambda pane, row, a: bool(numbered.fullmatch(pane.screen[row][:a]))
        accept = lambda text, kind: kind == 'word' and text
    before = WORD.findall(pane.screen[pane.cy][:start])[-CONTEXT:]
    out, seen = [], set()
    for text, row, end in ranked(pane, start, accept, before, where=where):
        item, following = item_at(pane, row, end - len(text))
        if item not in seen:
            seen.add(item)
            out.append({'text': item + ' ', 'following': following})
    return out


def sentences(pane, start, word):
    """Alternatives for the sentences on screen that start with WORD (smart
    case), each whole: up to its end (. ! ? : and a space), or when that
    comes first a blank row or a list item; line breaks as spaces."""
    out, seen = [], set()
    for text, following in candidates(pane, start, word, sentence_start, every=True):
        m = PART_END.search(following)
        found, block = ends(following, '.'), m.start() if m else len(following.rstrip())
        end = found[0] if found and found[0] <= block else block
        whole = text + taken(following, end)
        if whole not in seen:
            seen.add(whole)
            out.append({'text': whole + ' ', 'following': following[end:]})
    return out


# A mark just before a word (-Wh, .th): the list items or the sentences that
# start so, whole, and the mark goes; with none such, all words, the mark kept
# (-Wall, .bashrc).
MARKS = {'-': lambda pane, start, word: list_items(pane, start, word),
         '.': lambda pane, start, word: sentences(pane, start, word)}


def ranked(pane, start, accept, before, cursor_row=True, where=None):
    """[(text, row, end)] for the things on the pane's screen (words, coloured
    spans, paths) that ACCEPT(text, kind) turns into a TEXT: the coloured
    spans before the rest, and in each, first those whose words before them
    on screen (across rows) match the most of the words BEFORE, then in the
    pane's order for them (ORDERS; START: where what was typed starts on the
    cursor's row; a text counts as often as it is taken here). Not what is at
    START, nor anything on the cursor's row unless CURSOR_ROW, nor with WHERE
    anything at a place (pane, row, character) it does not take."""
    found, seen = [], []
    for row, line in enumerate(pane.screen):
        words = list(WORD.finditer(line))
        k = 0
        for a, b, kind in pane.items(row):
            while k < len(words) and words[k].end() <= a:
                seen.append(words[k].group())
                k += 1
            if row == pane.cy and (not cursor_row or a <= start < b or a == start):
                continue
            if where and not where(pane, row, a):
                continue
            text = accept(line[a:b], kind)
            if text:
                found.append((kind != 'span', -context(seen[-CONTEXT:], before), row, a, text, b))
        seen += [m.group() for m in words[k:]]
    counts = {}
    for *_, text, _ in found:
        counts[text] = counts.get(text, 0) + 1
    def key(f):
        group, ctx, row, a, text, _ = f
        order = ORDERS[pane.order(not group)]
        return (group, ctx, *order(pane, row, a, start, counts[text]), row, a, -len(text), text)
    return [(text, row, b) for *_, row, _, text, b in sorted(found, key=key)]


def candidates(pane, start, typed, where=None, spans_only=False, every=False):
    """[(text, following)] for each word or coloured span on the pane's screen
    that completes TYPED (from character START of the cursor's row), each
    once, best first (ranked); FOLLOWING is the text after it (after). A span
    may also complete the word with what is before it (#12 of #1234), or what
    is before it alone (TYPED empty: [" of ["a1f3"]). WHERE as in ranked;
    SPANS_ONLY: entities only; EVERY: each place, not each text once."""
    before = WORD.findall(pane.screen[pane.cy][:start])[-CONTEXT:]
    token = re.search(r'\S*$', pane.before).group()
    lead = token[:len(token) - len(typed)]

    def accept(text, kind):
        if kind == 'span' and lead and smartcase(token, text):
            text = text[len(lead):]
        elif kind == 'path' or (spans_only and kind != 'span') or not typed or not smartcase(typed, text):
            return None
        return text if every or text.lower() != typed.lower() else None   # a query: the word itself too
    out, seen = [], set()
    for text, row, end in ranked(pane, start, accept, before, where=where):
        if every or text not in seen:
            seen.add(text)
            out.append((text, after(pane.screen, pane.cy, row, end, start)))
    return out


def next_chunk(following):
    """(chunk, rest): the text up to the end of the next word in FOLLOWING, a
    gap holding a line break made one space; None when no word is left."""
    m = WORD.search(following)
    if not m:
        return None
    gap = following[:m.start()]
    if '\n' in gap:
        gap = ' '
    return gap + m.group(), following[m.end():]


def continuations(pane, following):
    """[(chunk, rest)] for what may come next after the text left of the
    cursor, each once: the next words in FOLLOWING (where the completion came
    from; None: none) first, then those after each other place on screen where
    the last word left of the cursor is, best first (ranked by the words
    before it)."""
    words = WORD.findall(pane.before)
    found = [next_chunk(following)] if following is not None else []
    if words:
        last = words[-1].lower()
        accept = lambda text, kind: kind == 'word' and text.lower() == last and text
        for _, row, end in ranked(pane, len(pane.before), accept, words[:-1][-CONTEXT:],
                                  cursor_row=False):
            found.append(next_chunk(after(pane.screen, pane.cy, row, end, 0)))
    out, seen = [], set()
    for chunk in found:
        if chunk and chunk[0] not in seen:
            seen.add(chunk[0])
            out.append(chunk)
    return out


def ends(following, target, exclusive=False):
    """Where in FOLLOWING the text up to TARGET (as in up_to) ends, in order;
    EXCLUSIVE: before the word or the mark, not after it, and before the
    spaces before it, so what follows starts with them."""
    before = lambda i: len(following[:i].rstrip())
    if target == '$':
        m = re.search(r'\S[^\n]*', following)
        return [m.end()] if m else []
    if target == '$$':
        m = BLOCK_END.search(following)
        return [m.start() if m else len(following.rstrip())]
    if target in '.?!':                         # . a sentence's end; ? ! that mark
        marks = '.!?:' if target == '.' else target
        return [before(m.start()) if exclusive else m.end()
                for m in re.finditer(r'[' + re.escape(marks) + r']["\'’”)\]]*(?=\s|$)', following)]
    return [before(m.start()) if exclusive else m.start() + len(re.match(r'\S*', following[m.start():]).group())
            for m in WORD.finditer(following) if smartcase(target, m.group())]


def taken(following, end):
    """FOLLOWING up to END, its line breaks one space, without trailing space."""
    return re.sub(r'\s*\n\s*', ' ', following[:end]).rstrip()


def up_to(pane, start, word, exclusive=False):
    """...WORD: the text on screen from where the text left of START leaves
    off up to a word that starts with WORD (smart case) and what is on it
    (consumes.), its line breaks one space; one alternative for each such
    word, in order, so M-/ goes on to the next. WORD $: to the end of the
    line; $$: to the end of the block (up to a blank row, lists and all).
    From the text the last Tab took its words from, when the state it left
    is for the text left of START; then from after each other place on
    screen where that text's last word is (ranked as Tab's continuations).
    What was typed after that last word (". " of "4. ") is not taken again."""
    anchor = pane.before[:start]
    found = list(WORD.finditer(anchor))
    if not found:
        return []
    words = [m.group() for m in found]
    tail = anchor[found[-1].end():].strip()
    sources = []
    state = pane.state(before=anchor)
    if state and state.get('backend') == 'screen':
        level = state['levels'][-1]
        if level['index'] < len(level['alts']) and 'following' in level['alts'][level['index']]:
            sources.append(level['alts'][level['index']]['following'])
    last = words[-1].lower()
    accept = lambda text, kind: kind == 'word' and text.lower() == last and text
    for _, row, end in ranked(pane, start, accept, words[:-1][-CONTEXT:], cursor_row=False):
        sources.append(after(pane.screen, pane.cy, row, end, 0))
    out, seen = [], set()
    for following in sources:
        if tail and following.lstrip(' ').startswith(tail):
            following = following.lstrip(' ')[len(tail):]
        for end in ends(following, word, exclusive):
            text = taken(following, end)
            text = (text.lstrip() if anchor[-1:].isspace() else text) + ' '
            if text not in seen:
                seen.add(text)
                out.append({'text': text, 'following': following[end:]})
    return out


# An opening quote or bracket right before what was typed (at a word's start):
# the completion is closed with its pair, the closer moving on with it.
CLOSERS = {'"': '"', "'": "'", '`': '`', '(': ')', '[': ']', '{': '}', '<': '>', '“': '”', '‘': '’'}


def closer(before, start):
    """The closer for the opener just before START in BEFORE, or ''. (One
    already right after the cursor is not added: see start.)"""
    opener = before[start - 1:start] if start else ''
    if opener in CLOSERS and (start == 1 or before[start - 2].isspace() or before[start - 2] in CLOSERS):
        return CLOSERS[opener]
    return ''


def shown(state):
    """(text, back): the text the completion puts in place of what was typed,
    the cursor BACK characters before its end: the chosen alternative of the
    last level, or with none chosen, the level's own (what was typed, or what
    the level goes on from); closed (CLOSERS) when the state says so, unless
    it holds the closer already."""
    level = state['levels'][-1]
    if level['index'] < len(level['alts']):
        alt = level['alts'][level['index']]
        text, back = alt['text'], alt.get('back', 0)
    elif len(state['levels']) > 1:
        text, back = level['none'], 0
    else:
        return level['none'], 0                 # what was typed, as it was
    close = state.get('close', '')
    if close and not back and text.endswith(' ') and close not in text:
        text = text[:-1] + close + ' '
    elif state.get('tight') and not back and text.endswith(' '):
        text = text[:-1]                        # up to the closer already there
    return text, back


# A backend: typed(pane, key) is (start, typed) for the word before the cursor
# it takes, else None; complete(pane, start, typed) the alternatives for it,
# best first, each {'text': what replaces typed, 'back': where the cursor is
# left, as characters before the end (none: at the end), ...}; follow(pane, start,
# chosen) those that go on from the chosen one, for Tab; and if it has one,
# go_on(pane, start, typed) those that go on from TYPED itself, for Tab when
# complete has none.

def snippet(raw):
    """(text, back) of a snippet's TEXT as written in the file: the escapes
    read, and the cursor BACK characters before the end, where | was."""
    out, cursor, i = [], None, 0
    while i < len(raw):
        if raw[i] == '\\' and i + 1 < len(raw):
            out.append({'n': '\n', 's': ' ', 't': '\t'}.get(raw[i + 1], raw[i + 1]))
            i += 2
            continue
        if raw[i] == '|' and cursor is None:
            cursor = len(out)
        else:
            out.append(raw[i])
        i += 1
    return ''.join(out), len(out) - cursor if cursor is not None else 0


def snippets():
    """{name: TEXT as written} from the file named by @dabbrev-snippets."""
    path = tmux('show-options', '-gqv', SNIPPETS_OPTION).strip() or SNIPPETS_DEFAULT
    try:
        with open(os.path.expanduser(path), encoding='utf-8') as f:
            lines = f.read().splitlines()
    except OSError:
        return {}
    out = {}
    for line in lines:
        parts = line.strip().split(None, 1)
        if parts and not parts[0].startswith('#'):
            out[parts[0]] = parts[1].strip() if len(parts) > 1 else ''
    return out


class Snippets:
    """,NAME: the snippets whose names start with NAME."""
    name = 'snippets'

    def typed(self, pane, key):
        m = SNIPPET_TYPED.search(pane.before)
        if m and (m.group(1) or key == 'expand'):
            return m.start(), m.group()
        return None

    def complete(self, pane, start, typed):
        out = []
        for name, raw in sorted(snippets().items()):
            if smartcase(typed[1:], name):
                text, back = snippet(raw)
                out.append({'text': text, 'back': back})
        return out

    def follow(self, pane, start, chosen):
        return []


class Screen:
    """The words on the pane's screen."""
    name = 'screen'

    def typed(self, pane, key):
        m = (QUERY_UPTO.search(pane.before) or UPTO_TYPED.search(pane.before)
             or LINE_TYPED.search(pane.before) or NUMBER_TYPED.search(pane.before))
        if m:
            return m.start(), m.group()
        least = 2 if key == 'tab' else 1
        m = TYPED.search(pane.before)
        if m and re.fullmatch(r'_\w[\w\'./-]*', m.group()) and re.search(OPEN + '$', pane.before[:m.start()]):
            return m.start(), m.group()             # _word: the row that starts so
        if m:
            lead = pane.before[:m.start()]
            mark = re.search(OPEN + r'[-.=]$', lead)
            if mark:                                # -word, .word (MARKS), =word
                return m.start() - 1, mark.group() + m.group()
            return (m.start(), m.group()) if len(m.group()) >= least else None
        if len(re.search(r'\S*$', pane.before).group()) >= least:
            return len(pane.before), ''         # punctuation only: for the spans that start with it
        return None

    def complete(self, pane, start, typed):
        if typed.startswith('..'):
            dots, target = re.fullmatch(UPTO, typed).groups()
            return up_to(pane, start, target, exclusive=dots == '...' and pane.ruby_ranges())
        if typed[:1] == '_' and len(typed) > 1:   # _xyz: ^xyz..$, else as before
            return self.query_up_to(pane, start, '^' + typed[1:], '$') or self.words(pane, start, typed)
        m = QUERY_UPTO.fullmatch(typed)
        if m:                                       # ^T..$$: each match of ^T, taken on
            dots, target = re.fullmatch(UPTO, m.group('op')).groups()
            return self.query_up_to(pane, start, m.group('query'), target,
                                    exclusive=dots == '...' and pane.ruby_ranges())
        if typed.startswith('^'):                   # line starts only; the ^ goes
            word = typed.lstrip('^ ')
            return self.words(pane, start + len(typed) - len(word), word, line_start)
        if typed[:1] == '=':                        # =word: entities only, of more words first
            alts = self.words(pane, start + 1, typed[1:], spans_only=True)
            return sorted(alts, key=lambda alt: ' ' not in alt['text'].rstrip())
        if NUMBER_TYPED.fullmatch(typed):            # 2.: the items numbered so, whole
            alts = list_items(pane, start, '', number=typed[:-1])
            return [{**alt, 'text': typed + ' ' + alt['text']} for alt in alts] or self.words(pane, start, typed)
        if typed[:1] in MARKS:                      # -word, .word: the mark gone; else as before
            word = typed[1:]
            return MARKS[typed[0]](pane, start + 1, word) or [
                {**alt, 'text': typed[0] + alt['text']} for alt in self.words(pane, start + 1, word)]
        return self.words(pane, start, typed)      # "- W", ". W": text, not anchors

    def query_up_to(self, pane, start, query, target, exclusive=False):
        """The matches of QUERY (typed from START) at every place on screen:
        its first word where its anchor says (a line's start, a list item's,
        a sentence's, an entity), the rest the words that follow there, each
        a prefix (smart case), the word itself too; each
        taken on to its first end for TARGET (ends): one alternative a
        match, so M-/ goes on to the next."""
        head = re.match(QUERY, query).group()
        rest = query[len(head):].split()
        word = re.sub(r'^(?:\^ ?|[-.=])', '', head)
        # The mark stands for its word only: -F is a list item's first word,
        # not the whole item, so -F.... ends at that word's sentence's end.
        where = {'^': line_start, '-': list_item, '.': sentence_start, '=': None}[head[0]]
        before, pane.before = pane.before, pane.before[:start + len(head)]
        try:
            alts = self.words(pane, start + len(head) - len(word), word, where,
                              spans_only=head[0] == '=', every=True)
        finally:
            pane.before = before
        out, seen = [], set()
        for alt in alts:
            following, text = alt.get('following'), alt['text'].rstrip()
            for word in rest if following is not None else ():
                m = WORD.search(following)
                if not m or re.search(r'\w', following[:m.start()]) or not smartcase(word, m.group()):
                    following = None
                    break
                text += taken(following, m.end())
                following = following[m.end():]
            found = ends(following, target, exclusive) if following is not None else []
            if found:
                text = text + taken(following, found[0]) + ' '
                if text not in seen:
                    seen.add(text)
                    out.append({'text': text, 'following': following[found[0]:]})
        return out

    @staticmethod
    def words(pane, start, typed, where=None, spans_only=False, every=False):
        return [{'text': text + ' ', 'following': following}
                for text, following in candidates(pane, start, typed, where, spans_only, every)]

    def follow(self, pane, start, chosen):
        return [{'text': chosen['text'][:-1] + chunk + ' ', 'following': rest}
                for chunk, rest in continuations(pane, chosen['following'])]

    def go_on(self, pane, start, typed):
        """A whole word: the words after it on screen."""
        return [{'text': typed + chunk + ' ', 'following': rest}
                for chunk, rest in continuations(pane, None)]


class Program:
    """Tab on a word starting @ or /: left to the program."""
    name = 'program'

    def typed(self, pane, key):
        token = re.search(r'\S*$', pane.before).group()
        if key == 'tab' and token[:1] in ('@', '/'):
            return len(pane.before) - len(token), token
        return None

    def complete(self, pane, start, typed):
        return []


class Paths:
    """Paths starting ~/, ./, ../, // or /folder/: those on screen, then the
    files in the folder."""
    name = 'paths'

    def typed(self, pane, key):
        m = PATH_TYPED.search(pane.before)
        return (m.start(), m.group()) if m else None

    def complete(self, pane, start, typed):
        path = typed[1:] if typed.startswith('//') else typed
        cut = path.rindex('/') + 1
        out, seen = [], set()
        for alt in self.on_screen(pane, start, path) + self.entries(pane, path[:cut], path[cut:]):
            if alt['text'] not in seen:
                seen.add(alt['text'])
                out.append(alt)
        return out

    def follow(self, pane, start, chosen):
        return self.complete(pane, start, chosen['text']) if chosen['text'].endswith('/') else []

    def on_screen(self, pane, start, path):
        """The paths on screen (plain or coloured) that start with PATH, written
        as it is (~/ or /), ranked; a folder ends in /, else a space."""
        home = os.path.expanduser('~')

        def accept(text, kind):
            if kind == 'word' or not SCREEN_PATH.match(text):
                return None
            if path.startswith('~/') and text.startswith(home + '/'):
                text = '~' + text[len(home):]
            elif path.startswith('/') and text.startswith('~/'):
                text = home + text[1:]
            if text.rstrip('/') == path.rstrip('/') or not smartcase(path, text):
                return None
            return text if text.endswith('/') else text + self.end(pane, text)
        before = WORD.findall(pane.screen[pane.cy][:start])[-CONTEXT:]
        return [{'text': text} for text, _, _ in ranked(pane, start, accept, before)]

    def entries(self, pane, folder, part):
        """The files in FOLDER whose names start with PART (smart case), by
        name: FOLDER, the name, and a / for a folder, else a space."""
        real = os.path.join(pane.cwd(), os.path.expanduser(folder))
        try:
            names = os.listdir(real)
        except OSError:
            return []
        out = []
        for name in sorted(names, key=str.lower):
            shown_name = unicodedata.normalize('NFC', name)      # macOS keeps names decomposed
            if (name.startswith('.') and not part.startswith('.')) or not smartcase(part, shown_name):
                continue
            out.append({'text': folder + shown_name + self.end(pane, os.path.join(real, name))})
        return out

    @staticmethod
    def end(pane, path):
        return '/' if os.path.isdir(os.path.join(pane.cwd(), os.path.expanduser(path))) else ' '


BACKENDS = [Snippets(), Paths(), Program(), Screen()]
BY_NAME = {backend.name: backend for backend in BACKENDS}


class Pane:
    def __init__(self, pane):
        self.pane = pane
        cx, cy, self.pid, height = map(int, tmux('display-message', '-p', '-t', pane,
                                                 '#{cursor_x} #{cursor_y} #{pane_pid} #{pane_height}').split())
        self.middle = (height - 1) / 2
        # -N keeps trailing spaces, so a space left of the cursor is seen.
        self.screen = tmux('capture-pane', '-p', '-N', '-t', pane).split('\n')
        self.cy = cy
        self.before = left_of(self.screen[cy] if cy < len(self.screen) else '', cx)
        self.after = (self.screen[cy] if cy < len(self.screen) else '')[len(self.before):]
        self._cwd = self._escaped = self._order = self._kinds = None

    def cwd(self):
        if self._cwd is None:
            self._cwd = tmux('display-message', '-p', '-t', self.pane, '#{pane_current_path}').strip()
        return self._cwd

    def ruby_ranges(self):
        """Whether ... leaves the end out (@dabbrev-ruby-ranges, on unless off)."""
        return tmux('show-options', '-gqv', RUBY_OPTION).strip() != 'off'

    def order(self, span):
        """The name of the order for coloured spans (SPAN) or the rest, or the
        default."""
        if self._order is None:
            self._order = {}
        if span not in self._order:
            name = tmux('show-options', '-gqv', ORDER_OPTIONS[span]).strip()
            self._order[span] = name if name in ORDERS else ORDER_DEFAULT
        return self._order[span]

    def items(self, row):
        """[(start, end, kind)] of ROW: its words, paths and entities (coloured
        spans and the rest, kind 'span'), by start, the longest first."""
        if self._escaped is None:
            self._escaped = tmux('capture-pane', '-p', '-e', '-N', '-t', self.pane).split('\n')
        line = self.screen[row]
        found = {(m.start(), m.end()): 'word' for m in WORD.finditer(line)}
        for a, b in paths(line):
            found.setdefault((a, b), 'path')
        if self._kinds is None:
            self._kinds = entity_kinds()
        for a, b in entities(line, self._escaped[row] if row < len(self._escaped) else None, self._kinds):
            found[(a, b)] = 'span'                      # a coloured or CamelCase word too
        return sorted(((a, b, kind) for (a, b), kind in found.items()), key=lambda f: (f[0], -f[1]))

    def state_file(self):
        server = tmux('display-message', '-p', '#{socket_path}').strip().replace('/', '%')
        folder = os.path.join(tempfile.gettempdir(), f'tmux-dabbrev-{os.getuid()}')
        os.makedirs(folder, mode=0o700, exist_ok=True)
        return os.path.join(folder, f'{server}{self.pane}.json')

    def state(self, before=None):
        """The state the last press left, if it left the cursor's row and the
        text left of the cursor as they are (or that text as BEFORE)."""
        try:
            with open(self.state_file()) as f:
                state = json.load(f)
        except (OSError, ValueError):
            return None
        at = [self.pid, self.cy, self.before if before is None else before]
        if state and 'start' in state and state.get('at') == at:
            return state
        return None

    def save(self, state):
        now = Pane(self.pane)
        state['at'] = [now.pid, now.cy, now.before]
        with open(self.state_file(), 'w') as f:
            json.dump(state, f)

    def replace(self, old, new):
        """Turn the text OLD into NEW, each (text, back) as shown gives it: the
        cursor first put at OLD's end, then left BACK characters before NEW's;
        and wait (briefly) until the screen shows it. Text with a line break
        goes in as a bracketed paste, so the program does not take it as
        Enter."""
        (old, old_back), (new, new_back) = old, new
        if old_back:
            tmux('send-keys', '-t', self.pane, '-N', str(old_back), 'Right')
        keep = 0
        while keep < min(len(old), len(new)) and old[keep] == new[keep]:
            keep += 1
        if len(old) > keep:
            tmux('send-keys', '-t', self.pane, '-N', str(len(old) - keep), 'BSpace')
        if '\n' in new[keep:]:
            tmux('set-buffer', '-b', 'tmux-dabbrev', '--', new[keep:])
            tmux('paste-buffer', '-p', '-d', '-b', 'tmux-dabbrev', '-t', self.pane)
        elif new[keep:]:
            tmux('send-keys', '-t', self.pane, '-l', '--', new[keep:])
        if new_back:
            tmux('send-keys', '-t', self.pane, '-N', str(new_back), 'Left')
        want = new[:len(new) - new_back].split('\n')[-1][-12:]
        end = time.monotonic() + 0.5
        while time.monotonic() < end:
            if Pane(self.pane).before.endswith(want):
                return
            time.sleep(0.02)

    def send_tab(self):
        tmux('send-keys', '-t', self.pane, 'Tab')


def step(pane, state, change):
    """Apply CHANGE to STATE, type the difference, remember the levels before
    for undo."""
    old = shown(state)
    state.setdefault('undo', []).append(json.loads(json.dumps(state['levels'])))
    change(state['levels'])
    pane.replace(old, shown(state))
    pane.save(state)


def start(pane, key):
    """Complete the word before the cursor to the best match of the first
    backend that takes it; False when there is nothing to complete."""
    for backend in BACKENDS:
        found = backend.typed(pane, key)
        if found:
            break
    else:
        return False
    alts = backend.complete(pane, *found)
    if not alts and key == 'tab' and hasattr(backend, 'go_on'):
        alts = backend.go_on(pane, *found)
    if not alts:
        return False
    close = closer(pane.before, found[0]) if backend.name != 'snippets' else ''
    tight = bool(close) and pane.after.startswith(close)     # it is there already (,rr's "|")
    state = {'backend': backend.name, 'start': found[0],
             'close': '' if tight else close, 'tight': tight,
             'levels': [{'none': found[1], 'alts': alts, 'index': len(alts)}]}
    step(pane, state, lambda levels: levels[-1].update(index=0))
    return True


def expand(pane):
    state = pane.state()
    if not state:
        start(pane, 'expand')
        return
    # Cycle the last level: its alternatives, then none.
    level = state['levels'][-1]
    step(pane, state, lambda levels: levels[-1].update(
        index=(level['index'] + 1) % (len(level['alts']) + 1)))


def tab(pane):
    state = pane.state()
    if state:
        level = state['levels'][-1]
        if level['index'] == len(level['alts']):        # none chosen: the first
            step(pane, state, lambda levels: levels[-1].update(index=0))
            return
        chosen = level['alts'][level['index']]
        alts = BY_NAME[state['backend']].follow(pane, state['start'], chosen)
        if alts:
            step(pane, state, lambda levels: levels.append(
                {'none': chosen['text'], 'alts': alts, 'index': 0}))
        return
    if not start(pane, 'tab'):
        pane.send_tab()


def undo(pane):
    state = pane.state()
    if not state or not state.get('undo'):
        return
    old = shown(state)
    state['levels'] = state['undo'].pop()
    pane.replace(old, shown(state))
    pane.save(state)


def bind():
    """Bind the keys in @dabbrev-key and @dabbrev-undo-key without the prefix,
    and Tab in the programs named in @dabbrev-tab-commands; unbind what was
    bound before and no longer is."""
    script = os.path.abspath(__file__)
    programs = tmux('show-options', '-gqv', TAB_OPTION)
    if programs == '' and not tmux('show-options', '-gq', TAB_OPTION):
        programs = TAB_DEFAULT                  # unset; set to '' to leave Tab alone
    programs = programs.split()
    old = tmux('show-options', '-gqv', '@dabbrev-bound-keys').split()
    keys = []
    for action, (option, default) in KEYS.items():
        key = tmux('show-options', '-gqv', option).strip() or default
        tmux('bind-key', '-n', key, 'run-shell', f"{script} {action} '#{{pane_id}}'")
        keys.append(key)
    if programs:
        match = '#{m/r:^(%s)$,#{pane_current_command}}' % '|'.join(map(re.escape, programs))
        tmux('bind-key', '-n', 'Tab', 'if-shell', '-F', match,
             f"run-shell \"{script} tab '#{{pane_id}}'\"", 'send-keys Tab')
        keys.append('Tab')
    for k in old:
        if k not in keys:
            tmux('unbind-key', '-n', k, check=False)
    tmux('set-option', '-g', '@dabbrev-bound-keys', ' '.join(keys))


if __name__ == '__main__':
    if sys.argv[1:] == ['bind']:
        bind()
    else:
        {'expand': expand, 'tab': tab, 'undo': undo}[sys.argv[1]](Pane(sys.argv[2]))
