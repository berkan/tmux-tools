#!/usr/bin/env python3
# tmux-expand-region expand|shrink PANE — grow the copy-mode selection in PANE
# to the next larger region around the cursor, or shrink it back, like Emacs'
# expand-region and expreg: every region that holds the cursor is found, and
# the smallest that is larger than the selection is chosen. From whitespace,
# the first region is the next word's. Shrink retraces the steps, then clears
# the selection; once the selection is changed by hand, shrinking just clears
# it.
#
# Regions come from rules: the defaults below (DEFAULT_RULES), then the file
# named by the @expand-region-rules option (default
# ~/.config/tmux-expand-region/rules), in the same form, one rule a line:
#   NAME  regex  PATTERN    each match is a region, and so is each named group
#                           in it: (?P<path>...)(?::\d+)? gives path and path:line
#   NAME  builtin           one of the BUILTINS below, for what a regex cannot
#                           match: pairs of brackets, rows, sentences
#   -NAME                   drop the rule called NAME
# A rule with a NAME already in use replaces it. Patterns are Python regexes
# over the view's text, rows joined by newlines.
#
# tmux-expand-region rules — print the rules in effect.
# tmux-expand-region bind — bind the keys in copy-mode-vi and copy-mode: the
# @expand-region-expand-key option (default =) and @expand-region-shrink-key
# (default -). Run it from tmux.conf after setting them.
import os
import re
import subprocess
import sys
import unicodedata

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
import pairs                                    # lib/pairs.py: the pairs the tools share

RULES_FILE = '~/.config/tmux-expand-region/rules'
DEFAULT_RULES = r"""
word       regex    [^\W_]+
symbol     regex    \w(?:[\w-]*\w)?
prefixed   regex    (?<![\w-])(?:--?|[$@#%])\w(?:[\w-]*\w)?
chain      builtin
call       builtin
path       regex    (?P<path>(?<![\w/.~-])(?:~|\.{1,2})?/?(?:[\w@%+=~.-]+/)+[\w@%+=~.-]*[\w@%+=~-]|(?<![\w/.~-])[\w@%+=~-]+\.[A-Za-z0-9]{1,8}(?![\w/]))(?::\d+){0,2}
url        regex    [A-Za-z][\w+.-]*://[^\s<>"'`]*[^\s<>"'`.,;:!?)\]}]
email      regex    [\w.+-]+@[\w-]+(?:\.[\w-]+)+
dquote     regex    "(?P<inside>(?:[^"\\\n]|\\.)*)"
squote     regex    (?<!\w)'(?P<inside>(?:[^'\\\n]|\\.)*)'(?!\w)
backquote  regex    `(?P<inside>[^`\n]*)`
pairs      builtin
comment    regex    (?m)^[ \t]*(#|//|--|;+)(?:[ \t].*)?(?:\n[ \t]*\1(?:[ \t].*)?)*
sentence   builtin
line       builtin
block      builtin
paragraph  builtin
view       builtin
"""
# The quote rules, for telling which brackets are inside strings.
STRINGS = re.compile(r'"(?:[^"\\\n]|\\.)*"|(?<!\w)\'(?:[^\'\\\n]|\\.)*\'(?!\w)|`[^`\n]*`')
KEYS = {'expand': ('@expand-region-expand-key', '='),
        'shrink': ('@expand-region-shrink-key', '-')}


def tmux(*args, check=True):
    return subprocess.run(['tmux', *args], check=check, text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout


def cell_width(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in 'WF' else 1


def column(line, i):
    """Screen column of character I of LINE; past the end, one per character."""
    col = sum(cell_width(ch) for ch in line[:i])
    return col + max(0, i - len(line))


def char_at(line, col):
    """Index of the character at screen column COL of LINE."""
    c = 0
    for i, ch in enumerate(line):
        if c + cell_width(ch) > col:
            return i
        c += cell_width(ch)
    return len(line) + col - c


class View:
    """The rows on screen as one text, positions as offsets into it."""

    def __init__(self, lines):
        self.lines = lines
        self.text = '\n'.join(lines)
        self.starts = []
        at = 0
        for line in lines:
            self.starts.append(at)
            at += len(line) + 1

    def offset(self, row, col):
        line = self.lines[row]
        return self.starts[row] + min(char_at(line, col), max(len(line) - 1, 0))

    def position(self, offset):
        """(row, col) of OFFSET."""
        row = max(r for r, s in enumerate(self.starts) if s <= offset)
        return row, column(self.lines[row], offset - self.starts[row])

    def trimmed(self, start, end):
        """START..END without whitespace at either end, or None if empty."""
        while start <= end and self.text[start].isspace():
            start += 1
        while end >= start and self.text[end].isspace():
            end -= 1
        return (start, end) if start <= end else None

    def rows(self, first, last):
        return self.trimmed(self.starts[first], self.starts[last] + len(self.lines[last]) - 1)


def indent(line):
    return len(line) - len(line.lstrip())


_brackets = None


def brackets():
    """{opener: closer} of the brackets: the pairs (@tmux-tools-pairs) of two
    different characters (the quotes are rules of their own)."""
    global _brackets
    if _brackets is None:
        _brackets = {o: c for o, c in pairs.pairs(tmux).items() if o != c}
    return _brackets


def pairs_in(text, p):
    """(open, close) of each bracket pair, skipping brackets inside strings
    other than one that holds P."""
    masked = [m.span() for m in STRINGS.finditer(text) if not m.start() <= p < m.end()]
    inside = bytearray(len(text))
    for a, b in masked:
        inside[a:b] = b'\1' * (b - a)
    stack, found = [], []
    for k, ch in enumerate(text):
        if inside[k]:
            continue
        if ch in brackets():
            stack.append(k)
        elif stack and ch == brackets()[text[stack[-1]]]:
            found.append((stack.pop(), k))
    return found


NAME = re.compile(r'\w+(?:(?:\.|::|->)\w+)*')       # f, re.finditer, a::b->c
CHAIN = re.compile(r'\w+(?:(?:\.|::|->)\w+)+')      # at least two members


def builtin_pairs(view, p):
    for o, c in pairs_in(view.text, p):
        if o <= p <= c:
            if o < p < c:
                yield o + 1, c - 1
            yield o, c


def builtin_chain(view, p):
    """The accessor chain from its start to each member at or after P's:
    re.finditer, a.b.c."""
    for m in CHAIN.finditer(view.text):
        if m.start() <= p < m.end():
            for end in re.finditer(r'\w+', m.group()):
                if m.start() + end.end() > p:
                    yield m.start(), m.start() + end.end() - 1


def builtin_call(view, p):
    """A name or accessor chain and the brackets right after it: f(x)."""
    closing = dict(pairs_in(view.text, p))
    for m in NAME.finditer(view.text):
        if m.end() in closing:
            yield m.start(), closing[m.end()]


def rows_of(view, row):
    """(first, last) of the paragraph around ROW: rows between blank rows."""
    lines = view.lines
    first = last = row
    while first > 0 and lines[first - 1].strip():
        first -= 1
    while last + 1 < len(lines) and lines[last + 1].strip():
        last += 1
    return first, last


def builtin_sentence(view, p):
    """The sentence in the paragraph around P: up to . ! or ? before a space."""
    row, _ = view.position(p)
    if not view.lines[row].strip():
        return
    first, last = rows_of(view, row)
    start = view.starts[first]
    text = view.text[start:view.starts[last] + len(view.lines[last])]
    for m in re.finditer(r'\S.*?(?:[.!?](?=\s)|[.!?]?$)', text, re.S):
        yield start + m.start(), start + m.end() - 1


def builtin_line(view, p):
    row, _ = view.position(p)
    yield view.rows(row, row)


def builtin_block(view, p):
    """The rows indented at least as far as P's, then each less indented line
    above, with everything indented under it (a bullet and its text)."""
    row, _ = view.position(p)
    lines, line = view.lines, view.lines[row]
    if not line.strip():
        return
    first = last = row
    while first > 0 and lines[first - 1].strip() and indent(lines[first - 1]) >= indent(line):
        first -= 1
    while last + 1 < len(lines) and lines[last + 1].strip() and indent(lines[last + 1]) >= indent(line):
        last += 1
    yield view.rows(first, last)
    while first > 0 and lines[first - 1].strip() and indent(lines[first - 1]) < indent(lines[first]):
        first -= 1
        end = first
        while end + 1 < len(lines) and lines[end + 1].strip() and indent(lines[end + 1]) > indent(lines[first]):
            end += 1
        yield view.rows(first, max(end, last))


def builtin_paragraph(view, p):
    row, _ = view.position(p)
    if view.lines[row].strip():
        yield view.rows(*rows_of(view, row))


def builtin_view(view, p):
    yield 0, len(view.text) - 1


BUILTINS = {name[len('builtin_'):]: f for name, f in globals().items()
            if name.startswith('builtin_')}


def load_rules():
    """[(name, kind, pattern)] from DEFAULT_RULES and the rules file; a
    message for each line that is not a rule."""
    rules, problems = {}, []
    path = os.path.expanduser(tmux('show-options', '-gqv', '@expand-region-rules', check=False).strip()
                              or RULES_FILE)
    sources = [('defaults', DEFAULT_RULES)]
    if os.path.exists(path):
        with open(path, encoding='utf-8') as f:
            sources.append((path, f.read()))
    for source, text in sources:
        for n, line in enumerate(text.split('\n'), 1):
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            if line.startswith('-'):
                rules.pop(line[1:].strip(), None)
                continue
            parts = line.split(None, 2)
            name, kind = parts[0], parts[1] if len(parts) > 1 else ''
            try:
                if kind == 'builtin' and name in BUILTINS:
                    rules[name] = (kind, None)
                elif kind == 'regex' and len(parts) == 3:
                    rules[name] = (kind, re.compile(parts[2]))
                else:
                    raise ValueError('not "NAME regex PATTERN", "NAME builtin" or "-NAME"')
            except (re.error, ValueError) as e:
                problems.append(f'{source}:{n}: {e}')
    return [(name, kind, pattern) for name, (kind, pattern) in rules.items()], problems


def regions(view, p, rules):
    """Every (start, end) region, inclusive, that holds offset P."""
    found = []
    for name, kind, pattern in rules:
        if kind == 'builtin':
            found += BUILTINS[name](view, p)
            continue
        for m in pattern.finditer(view.text):
            spans = [m.span()] + [m.span(g) for g in pattern.groupindex]
            found += [(a, b - 1) for a, b in spans if a <= p < b]
    trimmed = (view.trimmed(*r) for r in found if r and r[0] <= r[1])
    return {r for r in trimmed if r and r[0] <= p <= r[1]}


FIELDS = ['pane_in_mode', 'scroll_position', 'history_size', 'pane_height',
          'copy_cursor_x', 'copy_cursor_y', 'selection_present', 'selection_active',
          'selection_start_x', 'selection_start_y', 'selection_end_x', 'selection_end_y']


def read_info(pane):
    values = tmux('display-message', '-p', '-t', pane,
                  '\t'.join('#{%s}' % f for f in FIELDS)).rstrip('\n').split('\t')
    return dict(zip(FIELDS, values))


def move_to(pane, row, col, line):
    """Copy-mode cursor to (ROW, COL) of the view. It moves by character and
    does not always land where counted, so it is moved, read back and moved
    again (as in tmux-jump-click)."""
    for _ in range(4):
        info = read_info(pane)
        x, y = int(info['copy_cursor_x']), int(info['copy_cursor_y'])
        if y != row:
            count, cmd = row - y, 'cursor-down'
        else:
            count, cmd = char_at(line, col) - char_at(line, x), 'cursor-right'
        if not count:
            return
        if count < 0:
            count, cmd = -count, {'cursor-down': 'cursor-up', 'cursor-right': 'cursor-left'}[cmd]
        tmux('send-keys', '-t', pane, '-X', '-N', str(count), cmd)


def select(pane, view, region):
    (r0, c0), (r1, c1) = view.position(region[0]), view.position(region[1])
    tmux('send-keys', '-t', pane, '-X', 'clear-selection')
    move_to(pane, r0, c0, view.lines[r0])
    tmux('send-keys', '-t', pane, '-X', 'begin-selection')
    move_to(pane, r1, c1, view.lines[r1])


def main(action, pane):
    info = read_info(pane)
    if info['pane_in_mode'] != '1':
        return
    scroll, height = int(info['scroll_position']), int(info['pane_height'])
    top = int(info['history_size']) - scroll        # history line of the view's row 0
    lines = tmux('capture-pane', '-p', '-t', pane, '-S', str(-scroll),
                 '-E', str(height - 1 - scroll)).split('\n')[:height]
    view = View(lines + [''] * (height - len(lines)))
    cy, cx = int(info['copy_cursor_y']), int(info['copy_cursor_x'])

    def to_view(x, y):
        return min(max(int(y) - top, 0), height - 1), int(x)

    current = None
    # tmux 3.5 reports a one-character selection, start and end at the
    # cursor, as not present while it is still active.
    if '1' in (info['selection_present'], info['selection_active']):
        a = view.offset(*to_view(info['selection_start_x'], info['selection_start_y']))
        b = view.offset(*to_view(info['selection_end_x'], info['selection_end_y']))
        current = (min(a, b), max(a, b))
    # The steps so far, as history lines so scrolling does not upset them:
    # "point" or "start-end" entries, the last one the selection now shown.
    here = (f'{top + cy}:{cx}' if current is None else
            '%d:%d-%d:%d' % (*absolute(view, top, current[0]), *absolute(view, top, current[1])))
    stack = tmux('show-options', '-pqv', '-t', pane, '@expand-region-stack').strip().split(';')
    if not stack or stack[-1] != here:
        stack = [here]

    if action == 'expand':
        rules, problems = load_rules()
        if problems:
            tmux('display-message', '-t', pane, 'tmux-expand-region: ' + '; '.join(problems))
        if current is None:
            p = view.offset(cy, cx)
            while p < len(view.text) - 1 and view.text[p].isspace():
                p += 1                       # from whitespace, the next word
            bigger = regions(view, p, rules)
        else:
            bigger = [r for r in regions(view, current[0], rules) | regions(view, current[1], rules)
                      if r[0] <= current[0] and r[1] >= current[1] and r != current]
        if not bigger:
            return
        region = min(bigger, key=lambda r: (r[1] - r[0], r))
        select(pane, view, region)
        stack.append('%d:%d-%d:%d' % (*absolute(view, top, region[0]),
                                      *absolute(view, top, region[1])))
    else:
        if len(stack) < 2:
            tmux('send-keys', '-t', pane, '-X', 'clear-selection')
            stack = []
        else:
            stack.pop()
            back = stack[-1]
            if '-' in back:
                start, end = (from_absolute(view, top, s) for s in back.split('-'))
                select(pane, view, (start, end))
            else:
                tmux('send-keys', '-t', pane, '-X', 'clear-selection')
                row, col = map(int, back.split(':'))
                if 0 <= row - top < height:
                    move_to(pane, row - top, col, view.lines[row - top])
                stack = []
    tmux('set-option', '-p', '-t', pane, '@expand-region-stack', ';'.join(stack))


def absolute(view, top, offset):
    row, col = view.position(offset)
    return top + row, col


def from_absolute(view, top, spec):
    row, col = map(int, spec.split(':'))
    return view.offset(min(max(row - top, 0), len(view.lines) - 1), col)


def bind():
    script = os.path.abspath(__file__)
    old = tmux('show-options', '-gqv', '@expand-region-bound-keys').split()
    keys = []
    for action, (option, default) in KEYS.items():
        key = tmux('show-options', '-gqv', option).strip() or default
        keys.append(key)
        for table in ('copy-mode-vi', 'copy-mode'):
            tmux('bind-key', '-T', table, key, 'run-shell',
                 f"{script} {action} '#{{pane_id}}'")
    for key in old:
        if key not in keys:
            for table in ('copy-mode-vi', 'copy-mode'):
                tmux('unbind-key', '-T', table, key, check=False)
    tmux('set-option', '-g', '@expand-region-bound-keys', ' '.join(keys))


if __name__ == '__main__':
    if sys.argv[1:] == ['bind']:
        bind()
    elif sys.argv[1:] == ['rules']:
        rules, problems = load_rules()
        for name, kind, pattern in rules:
            print(f'{name:<11}{kind:<9}{pattern.pattern if pattern else ""}'.rstrip())
        for problem in problems:
            print(problem, file=sys.stderr)
    else:
        main(sys.argv[1], sys.argv[2])
