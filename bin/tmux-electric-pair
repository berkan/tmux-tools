#!/usr/bin/env python3
# tmux-electric-pair — brackets and quotes typed in pairs, as Emacs'
# electric-pair-mode, from what the screen shows around the program's cursor
# (tmux cannot see the program's input):
#   an opener   ( [ { types its pair, the cursor between: (|); not before a
#               letter or digit, nor after a backslash
#   a quote     " ' ` the same, and not after a letter or digit either (don't)
#   a closer    ) ] } or a quote, with the same right after the cursor, steps
#               over it instead of typing a second; and right where dabbrev
#               has just closed its completion with it ("hello" |), is not
#               typed again (once)
#   BSpace      in an empty pair it typed, (|), takes both
#   Tab         with a closer right after the cursor, steps over it: (hello|)
#               to (hello)|; else does what it did before (dabbrev's
#               completion). With @electric-pair-tab off, always the latter.
# Anything else is typed as it is.
#
# The pairs are in the @electric-pair-pairs option, two characters each
# [()[]{}""''``].
#
# tmux-electric-pair bind — bind each character of the pairs, BSpace and Tab,
# without the prefix, in the programs named in @electric-pair-commands (by
# #{pane_current_command}, each a regular expression for the whole name, with
# no , or }) [claude codex pi node agy gemini [0-9.]+ — Claude Code on macOS
# is named for its version]; elsewhere the key goes on as it is. '' binds
# nothing, and gives Tab back what it did. Run it from tmux.conf after setting
# the options, and after whatever binds Tab (tmux-tools.tmux runs it last).
#
# For speed, the bindings decide what they can in tmux's formats, with no
# process (the character after the cursor is #{cursor_character}): a closer,
# Tab, BSpace but in an empty pair it typed, an opener before a letter or
# digit. The rest needs the character before the cursor too:
# `tmux-electric-pair key KEY PANE X Y PAIRS EMPTY` reads the row and types
# KEY; after typing or taking a pair, it waits (briefly) for the program to
# show its cursor where that leaves it, so that the next key's formats read
# the screen as it now is. The bindings run in the foreground, so keys typed
# meanwhile wait and stay in order.
import os
import re
import sys
import time
import unicodedata

PAIRS_OPTION, PAIRS_DEFAULT = '@electric-pair-pairs', '()[]{}""' "''" '``'
# Claude Code on macOS is named for its version (2.1.310).
COMMANDS_OPTION, COMMANDS_DEFAULT = '@electric-pair-commands', r'claude codex pi node agy gemini [0-9.]+'


def tmux(*args):
    """Run tmux with ARGS, its output. (Not subprocess: importing it takes
    longer than all the rest of a key.)"""
    r, w = os.pipe()
    null = os.open(os.devnull, os.O_WRONLY)
    pid = os.posix_spawnp('tmux', ['tmux', *args], os.environ, file_actions=[
        (os.POSIX_SPAWN_DUP2, w, 1), (os.POSIX_SPAWN_DUP2, null, 2), (os.POSIX_SPAWN_CLOSE, r)])
    os.close(w)
    os.close(null)
    out = b''
    while chunk := os.read(r, 65536):
        out += chunk
    os.close(r)
    os.waitpid(pid, 0)
    return out.decode('utf-8', 'replace')


def option(name, default):
    """The global option NAME, or DEFAULT when it is unset (not when '')."""
    if not tmux('show-options', '-gq', name):
        return default
    return tmux('show-options', '-gqv', name).rstrip('\n')


def pairs():
    """{opener: closer} from @electric-pair-pairs."""
    text = option(PAIRS_OPTION, PAIRS_DEFAULT)
    return {text[i]: text[i + 1] for i in range(0, len(text) - 1, 2)}


def cell_width(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in 'WF' else 1


def left_of(line, cx):
    """The characters of LINE in the cells left of column CX."""
    col = 0
    for i, ch in enumerate(line):
        if col >= cx:
            return line[:i]
        col += cell_width(ch)
    return line


def around(pane, cy, cx=None):
    """(before, after, cx, cy): row CY left and right of the cursor, and where
    the cursor is (CX: as given, else as it is now). One tmux call."""
    out = tmux('display-message', '-p', '-t', pane, '#{cursor_x} #{cursor_y}', ';',
               'capture-pane', '-p', '-N', '-t', pane, '-S', str(cy), '-E', str(cy))
    now, _, row = out.partition('\n')
    row = row.rstrip('\n')
    x, y = (cx, cy) if cx is not None else map(int, now.split())
    before = left_of(row, x)
    return before, row[len(before):], x, y


# Tab steps over a closer right after the cursor unless @electric-pair-tab is
# off (read at each press); else it does what it did before, which is kept in
# TAB_WAS (dabbrev's completion, say).
TAB_ON = '#{!=:#{@electric-pair-tab},off}'
TAB_WAS = '@electric-pair-tab-was'

# The pane option holding the places (|X:Y|...) where it left an empty pair:
# BSpace there may take both, elsewhere it is BSpace with no process.
EMPTY = '@electric-pair-empty'


def until(pane, cy, done):
    """Wait (at most 0.3 s) until DONE(before, after, cx, cy) holds for the
    screen; what it last read, or None if it never did."""
    end = time.monotonic() + 0.3
    while time.monotonic() < end:
        now = around(pane, cy)
        if done(*now):
            return now
        time.sleep(0.003)
    return None


def pairs_here(key, prev, nxt, table):
    """Whether KEY, typed between PREV and NXT, should be paired."""
    quote = table[key] == key
    return not (nxt.isalnum() or prev == '\\' or (quote and prev.isalnum()))


def press(key, pane, cx, cy, table, empty):
    """Type KEY (an opener, or BSpace in an empty pair: the bindings do the
    rest) into PANE, its cursor at column CX of row CY when the key was
    pressed; TABLE the pairs, EMPTY the option of that name.

    Keys typed just before may not be on the screen yet, so it is not read
    ahead of KEY: an opener goes in first, and once the screen shows it
    before the cursor, it shows all typed before it too, and the closer
    follows if what is around it says so. BSpace goes in first too, and the
    closer after it goes as well only if the screen then shows the row as it
    was with the opener taken out: else something typed meanwhile changed it.
    After a pair or a pair taken, it waits for the program's cursor, so that
    the next key's formats read the screen as it now is."""
    send = lambda *keys: tmux('send-keys', '-t', pane, *keys)
    places = [p for p in empty.split('|') if p]
    if key == 'BSpace':
        before, after, _, _ = around(pane, cy, cx)
        prev = before[-1:]
        send('BSpace')
        if prev in table and after[:1] == table[prev]:
            back = cx - cell_width(prev)
            now = until(pane, cy, lambda b, a, x, y: (x, y, b) == (back, cy, before[:-1]) and a.startswith(after[:1]))
            if now:
                left = [p for p in places if p != f'{cx}:{cy}']
                send('Right', 'BSpace', ';', 'set-option', '-p', '-t', pane, EMPTY, '|' + '|'.join(left) + '|')
                until(pane, cy, lambda b, a, x, y: x == back and b + a != now[0] + now[1])
        return
    send('-l', '--', key)
    now = until(pane, cy, lambda b, a, x, y: (x, y) != (cx, cy) and b.endswith(key))
    if now and pairs_here(key, now[0][-2:-1], now[1][:1], table):
        places = [p for p in places if p != f'{now[2]}:{cy}'][-20:] + [f'{now[2]}:{cy}']
        send('-l', '--', table[key], ';', 'send-keys', '-t', pane, 'Left',
             ';', 'set-option', '-p', '-t', pane, EMPTY, '|' + '|'.join(places) + '|')
        until(pane, cy, lambda b, a, x, y: x == now[2] and b + a != now[0] + now[1])


def code(key):
    """KEY, a key name or U+XXXX for a character, as the key."""
    return chr(int(key[2:], 16)) if key.startswith('U+') else key


def quoted(text):
    """TEXT as one word of tmux's command language."""
    if "'" not in text:
        return "'%s'" % text
    return '"%s"' % ''.join('\\' + c if c in '\\"$' else c for c in text)


def any_of(conditions):
    """The format true when any of CONDITIONS is."""
    out = conditions[0]
    for c in conditions[1:]:
        out = '#{||:%s,%s}' % (out, c)
    return out


def bindings(script, programs, table, tab):
    """The tmux commands (for source-file, where { } blocks nest) that bind
    the pairs' characters and BSpace, and Tab around TAB (what Tab did
    before, a command; '' for none); and the keys they bind, but Tab."""
    gate = '#{m/r:^(%s)$,#{pane_current_command}}' % '|'.join(programs)
    alnum = '#{m/r:^[[:alnum:]]$,#{cursor_character}}'
    # Each character is compared through an option, as , and } cannot be
    # written in a format.
    def after(ch):
        return '#{==:#{cursor_character},#{@electric-pair-%04X}}' % ord(ch)

    def closed(ch):                             # dabbrev has just closed with it here
        return '#{==:#{cursor_x} #{cursor_y} #{@electric-pair-%04X},#{@dabbrev-closed}}' % ord(ch)

    codes = ','.join(f'{ord(o):04X}{ord(c):04X}' for o, c in table.items())

    def run(key):                               # the pairs go with it, as codes
        return 'run-shell ' + quoted(f'{script} key {key} #{{pane_id}} #{{cursor_x}} #{{cursor_y}} {codes} "#{{{EMPTY}}}"')

    closers = list(dict.fromkeys(table.values()))
    lines, keys = [], []
    for ch in dict.fromkeys([*table, *closers]):
        lines.append(f'set-option -g @electric-pair-{ord(ch):04X} {quoted(ch)}')
        typed = f'send-keys -l {quoted(ch)}'
        then = typed
        if ch in table:                         # an opener (a quote too): it may pair
            then = f'if-shell -F {quoted(alnum)} {{ {typed} }} {{ {run(f"U+{ord(ch):04X}")} }}'
        if ch in closers:
            then = (f'if-shell -F {quoted(after(ch))} {{ send-keys Right }} {{ '
                    f'if-shell -F {quoted(closed(ch))} {{ set-option -pu @dabbrev-closed }} {{ {then} }} }}')
        lines.append(f'bind-key -n {quoted(ch)} if-shell -F {quoted(gate)} {{ {then} }} {{ {typed} }}')
        keys.append(ch)
    if closers:
        steps = '#{&&:%s,#{&&:%s,%s}}' % (TAB_ON, gate, any_of([after(c) for c in closers]))
        lines.append(f'bind-key -n Tab if-shell -F {quoted(steps)} {{ send-keys Right }} {{ {tab or "send-keys Tab"} }}')
        in_empty = '#{&&:%s,#{&&:%s,#{m:*|#{cursor_x}:#{cursor_y}|*,#{%s}}}}' % (
            gate, any_of([after(c) for c in closers]), EMPTY)
        lines.append(f'bind-key -n BSpace if-shell -F {quoted(in_empty)} '
                     f'{{ {run("BSpace")} }} {{ send-keys BSpace }}')
        keys.append('BSpace')
    return lines, keys


def tab_before():
    """What Tab did before it was bound here: a command, or '' for none; and
    whether it is bound here now."""
    m = re.match(r'bind-key\s+(?:-r\s+)?-T\s+root\s+Tab\s+(.*)', tmux('list-keys', '-T', 'root', 'Tab'))
    if m and TAB_ON in m.group(1):
        return tmux('show-options', '-gqv', TAB_WAS).rstrip('\n'), True
    return (m.group(1).strip() if m else ''), False


def bind():
    """Bind the pairs' characters, BSpace and Tab in the programs named in
    @electric-pair-commands; unbind what was bound before and no longer is,
    and give Tab back what it did."""
    script = os.path.abspath(__file__)
    programs = option(COMMANDS_OPTION, COMMANDS_DEFAULT).split()
    old = [code(k) for k in tmux('show-options', '-gqv', '@electric-pair-bound-keys').split()]
    table = pairs()
    tab, ours = tab_before()
    lines, keys = bindings(script, programs, table, tab) if programs else ([], [])
    if programs and table:
        lines.append(f'set-option -g {TAB_WAS} {quoted(tab)}')
    elif ours:
        lines.append(f'bind-key -n Tab {tab}' if tab else 'unbind-key -n Tab')
    lines += [f'unbind-key -n {quoted(k)}' for k in old if k not in keys]
    lines.append('set-option -g @electric-pair-bound-keys ' +
                 quoted(' '.join(f'U+{ord(k):04X}' if len(k) == 1 else k for k in keys)))
    path = os.path.join(os.environ.get('TMPDIR', '/tmp'), f'tmux-electric-pair-{os.getpid()}.conf')
    with open(path, 'w') as f:
        f.write('\n'.join(lines) + '\n')
    try:
        tmux('source-file', path)
    finally:
        os.unlink(path)


if __name__ == '__main__':
    if sys.argv[1:] == ['bind']:
        bind()
    elif sys.argv[1:2] == ['key'] and len(sys.argv) == 8:
        key, pane, cx, cy, codes, empty = sys.argv[2:]
        table = {chr(int(c[:4], 16)): chr(int(c[4:], 16)) for c in codes.split(',') if c}
        press(code(key), pane, int(cx), int(cy), table, empty)
    else:
        sys.exit('usage: tmux-electric-pair bind | key KEY PANE X Y PAIRS EMPTY')
