#!/usr/bin/env python3
# tmux-link open|copy|quote|paste|target PANE [CLIENT] [COMMAND] — act on the
# hyperlink (OSC 8) under PANE's copy-mode cursor: on its target, not the
# text shown. Claude Code links each file it names, showing a short path
# (drafts/x.md) for the full one (file:///Users/me/notes/drafts/x.md); a
# file link's target is its path. Off a link, copy, quote, paste and target
# take the entity under the cursor whole, as tmux-dabbrev knows them, when it
# is beside this script (its entities: a coloured span, a CamelCase word, a
# run of Capitalised Words, the kinds in @dabbrev-entities; the longest that
# holds the cursor); without it, links only.
#
#   open    (links only) a file or folder: $VISUAL (else $EDITOR, else vi) in
#           a popup on CLIENT; one not on this machine: a message. Any other
#           link: the opener in @link-opener (unset: open, else xdg-open; ''
#           none) opens it; with none, it is copied, with a message.
#   copy    to tmux's buffer (and so the clipboard), leaving copy mode
#   quote   re: "<target>" -- typed into PANE (as tmux-quote-reply does)
#   paste   typed into PANE (bracketed paste), leaving copy mode
#   target  printed
#   quote-buffer   re: "<newest buffer>" -- typed into PANE
#
# Off a link, COMMAND (a copy-mode command such as other-end) is run instead,
# so the key keeps its own meaning there.
#
# tmux-link bind — bind o, Enter, y, r and p in copy-mode-vi: with a selection
# (more than the cursor's cell: @has-selection) as tmux's own (r quotes it),
# else on the link or entity under the cursor. Run it from tmux.conf.
#
# The link is read off the screen (capture-pane -e). Before tmux 3.5 copy mode
# keeps no links, so there the pane leaves copy mode to be read, and off a
# link goes back into it, at the same place.
import importlib.machinery
import importlib.util
import os
import re
import shlex
import shutil
import subprocess
import sys
import unicodedata
import urllib.parse

OSC8 = re.compile(r'\x1b\]8;[^;\x07\x1b]*;([^\x07\x1b]*)(?:\x07|\x1b\\)')
ESCAPE = re.compile(r'\x1b\[[0-9;:?]*[A-Za-z]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b.')


OPENER_OPTION = '@link-opener'
# More than the cursor's cell selected: where jump-click lands a selection is
# begun, and tmux 3.4 counts it as present at once (3.5 not until the cursor
# moves).
HAS_SELECTION = ('#{&&:#{selection_present},#{||:#{!=:#{selection_start_x},#{selection_end_x}},'
                 '#{!=:#{selection_start_y},#{selection_end_y}}}}')


def dabbrev():
    """tmux-dabbrev, beside this script, as a module (for its entities), or
    None when it is not there."""
    sys.dont_write_bytecode = True              # no __pycache__ beside the scripts
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'tmux-dabbrev')
    if not os.path.exists(path):
        return None
    loader = importlib.machinery.SourceFileLoader('tmux_dabbrev', path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def tmux(*args, check=True):
    return subprocess.run(['tmux', *args], check=check, text=True,
                          stdout=subprocess.PIPE).stdout


def cell_width(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in 'WF' else 1


def link_at(line, cx):
    """The link target at cell CX of LINE as capture-pane -e gives it, or ''."""
    link, col, pos = '', 0, 0
    while pos < len(line):
        m = OSC8.match(line, pos) or ESCAPE.match(line, pos)
        if m:
            if m.re is OSC8:
                link = m.group(1)
            pos = m.end()
            continue
        width = cell_width(line[pos])
        if col <= cx < col + max(width, 1):
            return link
        col += width
        pos += 1
    return ''


def links_in_copy_mode():
    """Whether tmux keeps links in copy mode (3.5 on)."""
    m = re.match(r'(\d+)\.(\d+)', tmux('display-message', '-p', '#{version}'))
    return not m or (int(m[1]), int(m[2])) >= (3, 5)


def char_index(line, col):
    """The index in LINE (plain text) of the character at cell COL."""
    at = 0
    for i, ch in enumerate(line):
        if at >= col:
            return i
        at += cell_width(ch)
    return len(line)


def back_to(pane, place, line):
    """Copy mode again with its cursor at PLACE (cx, cy, scroll), LINE being
    the cursor's row: the view scrolled back as far, then the cursor moved,
    checked and moved again (it moves by character, not cell)."""
    cx, cy, scroll = place
    tmux('copy-mode', '-t', pane)
    if scroll:
        tmux('send-keys', '-t', pane, '-X', '-N', str(scroll), 'scroll-up')
    for cmd in ['top-line', 'start-of-line']:
        tmux('send-keys', '-t', pane, '-X', cmd)
    plain = ESCAPE.sub('', OSC8.sub('', line))
    for _ in range(4):
        x, y = map(int, tmux('display-message', '-p', '-t', pane,
                             '#{copy_cursor_x} #{copy_cursor_y}').split())
        if y != cy:
            count, cmd = cy - y, 'cursor-down'
        else:
            count, cmd = char_index(plain, cx) - char_index(plain, x), 'cursor-right'
        if not count:
            break
        if count < 0:
            count, cmd = -count, {'cursor-down': 'cursor-up', 'cursor-right': 'cursor-left'}[cmd]
        tmux('send-keys', '-t', pane, '-X', '-N', str(count), cmd)


def entity_at(line, cx):
    """The longest entity (dabbrev's) of LINE, as capture-pane -e gives it,
    that holds cell CX, or ''."""
    d = dabbrev()
    if d is None:
        return ''
    plain = ESCAPE.sub('', line)
    i = char_index(plain, cx)
    found = [(a, b) for a, b in d.entities(plain, line, d.entity_kinds()) if a <= i < b]
    return max((plain[a:b] for a, b in found), key=len, default='')


def target(pane, keep_mode):
    """(link, entity) under PANE's copy cursor: the link's target, a file
    link's as its path, and the entity there (entity_at); '' for none. Copy
    mode may be left to read them (before tmux 3.5): then it is gone back to
    when there is neither or KEEP_MODE."""
    place = tuple(map(int, tmux('display-message', '-p', '-t', pane,
                                '#{copy_cursor_x} #{copy_cursor_y} #{scroll_position}').split()))
    cx, cy, scroll = place
    left = not links_in_copy_mode()
    if left:
        tmux('send-keys', '-t', pane, '-X', 'cancel')
    row = str(cy - scroll)                      # 0 is the top of the screen; history is above
    line = tmux('capture-pane', '-p', '-e', '-N', '-t', pane, '-S', row, '-E', row).rstrip('\n')
    link = link_at(line, cx)
    entity = '' if link else entity_at(line, cx)
    if left and (keep_mode or not (link or entity)):
        back_to(pane, place, line)
    url = urllib.parse.urlsplit(link)
    return (urllib.parse.unquote(url.path) if url.scheme == 'file' else link), entity


def leave(pane):
    if tmux('display-message', '-p', '-t', pane, '#{pane_in_mode}').strip() == '1':
        tmux('send-keys', '-t', pane, '-X', 'cancel')


def copy(text):
    # -w also sets the clipboard, through the client's terminal; with none
    # attached (a test) tmux refuses it, so without.
    if subprocess.run(['tmux', 'set-buffer', '-w', '--', text], stderr=subprocess.DEVNULL).returncode:
        tmux('set-buffer', '--', text)


def opener():
    """The command that opens a link (@link-opener; unset: open, else
    xdg-open, as found), as a list, or None."""
    if tmux('show-options', '-gq', OPENER_OPTION).strip():
        command = tmux('show-options', '-gqv', OPENER_OPTION).strip()
        return shlex.split(command) if command else None
    found = shutil.which('open') or shutil.which('xdg-open')
    return [found] if found else None


def open_(pane, client, text):
    if not text.startswith('/'):
        command = opener()
        if command:
            subprocess.Popen([*command, text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            copy(text)
            tmux('display-message', '-c', client, f'Nothing opens links here (@link-opener); copied: {text}')
    elif not os.path.exists(text):
        tmux('display-message', '-c', client, f'Not on this machine: {text}')
    else:
        editor = shlex.split(os.environ.get('VISUAL') or os.environ.get('EDITOR') or 'vi')
        folder = text if os.path.isdir(text) else os.path.dirname(text)
        tmux('display-popup', '-c', client, '-t', pane, '-E', '-w', '90%', '-h', '90%',
             '-d', folder, shlex.join([*editor, text]))


def quote(pane, text):
    """re: "TEXT" -- typed into PANE, out of copy mode first."""
    tmux('copy-mode', '-q', '-t', pane)
    tmux('set-buffer', '-b', 'tmux-link', '--', f're: "{text}" -- ')
    tmux('paste-buffer', '-p', '-d', '-b', 'tmux-link', '-t', pane)


def bind():
    """Bind o, Enter, y, r and p in copy-mode-vi (see above)."""
    me = shlex.quote(os.path.abspath(__file__))
    tmux('set-option', '-g', '@has-selection', HAS_SELECTION)
    keys = {
        'y': ('send-keys -X copy-selection-and-cancel', f"run-shell \"{me} copy '#{{pane_id}}' '' copy-selection-and-cancel\""),
        'r': (f"send-keys -X copy-selection-and-cancel ; run-shell \"{me} quote-buffer '#{{pane_id}}'\"",
              f"run-shell \"{me} quote '#{{pane_id}}'\""),
        'p': ('send-keys -X copy-selection-and-cancel ; paste-buffer -p', f"run-shell \"{me} paste '#{{pane_id}}'\""),
        'o': ('send-keys -X other-end', f"run-shell -b \"{me} open '#{{pane_id}}' '#{{client_name}}' other-end\""),
        'Enter': ('send-keys -X copy-pipe-and-cancel',
                  f"run-shell -b \"{me} open '#{{pane_id}}' '#{{client_name}}' copy-pipe-and-cancel\""),
    }
    for key, (selected, otherwise) in keys.items():
        tmux('bind-key', '-T', 'copy-mode-vi', key, 'if-shell', '-F', '#{E:@has-selection}', selected, otherwise)


def main(action, pane=None, client=None, command=None):
    if action == 'bind':
        bind()
        return
    if action == 'quote-buffer':
        text = subprocess.run(['tmux', 'show-buffer'], text=True, stdout=subprocess.PIPE).stdout
        if text:
            quote(pane, text)
        return
    link, entity = target(pane, keep_mode=action in ('target', 'open'))
    text = link if action == 'open' else link or entity
    if action == 'target':
        print(text)
    elif not text:
        if command:
            tmux('send-keys', '-t', pane, '-X', command)
    elif action == 'open':
        open_(pane, client, text)
    elif action == 'copy':
        copy(text)
        leave(pane)
    elif action == 'paste':
        leave(pane)
        tmux('set-buffer', '-b', 'tmux-link', '--', text)
        tmux('paste-buffer', '-p', '-d', '-b', 'tmux-link', '-t', pane)
    elif action == 'quote':
        copy(text)
        quote(pane, text)


if __name__ == '__main__':
    main(*sys.argv[1:])
